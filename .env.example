# ProRack Move: Convex environment variables.
# Set these in the Convex dashboard (your project > Production > Settings > Environment Variables)
# or with `npx convex env set NAME value --prod`. Never commit real values. None of them reach the browser.

# ERP (ERPNext) - the system of record. Start with UAT.
ERP_BASE_URL=https://erpuat.prorackglobal.com
ERP_API_KEY=
ERP_API_SECRET=

# Microsoft 365 sign-in (Entra ID app registration, single tenant, Web redirect URI:
#   https://<your-deployment>.convex.site/api/auth/callback )
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Who sees "All requests" (comma-separated work emails)
TRAVEL_ADMIN_EMAILS=

# Optional
ADMIN_CAN_APPROVE=             # 1 = Travel Admins may also decide approvals. Leave empty so only the ERP expense approver can.
APP_ENVIRONMENT=UAT            # label shown in the app header
UAT_LOGIN_PASSCODE=            # 8+ characters: enables "Sign in for UAT testing" by email + passcode. Remove for production.
APP_BASE_URL=                  # only when a custom domain is used, e.g. https://travel.prorack.ai
ERP_TRAVEL_FUNDING=            # Travel Request "Travel Funding" option to use; default = ERP's first option
